+/// Present into the host's default framebuffer while its context is current.
+pub fn presentToHost(self: *OpenGL, target: Target) !void {
+    _ = self;
+    try gl.disable(gl.c.GL_FRAMEBUFFER_SRGB);
+    defer gl.enable(gl.c.GL_FRAMEBUFFER_SRGB) catch {};
+    const read = try target.framebuffer.bind(.read);
+    defer read.unbind();
+    const draw = try (gl.Framebuffer{ .id = 0 }).bind(.draw);
+    defer draw.unbind();
+    try gl.blitFramebuffer(
+        0,
+        0,
+        @intCast(target.width),
+        @intCast(target.height),
+        0,
+        0,
+        @intCast(target.width),
+        @intCast(target.height),
+        .{ .color_buffer_bit = true },
+        .nearest,
+    );
 }
 
